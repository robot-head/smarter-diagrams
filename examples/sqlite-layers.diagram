# Layered embedded database engine (after Pikchr's SQLite architecture diagram).
core: Core {
  iface: "C API\nInterface"
  cmd: "Command\nProcessor"
  vm: "Virtual\nMachine"
  iface -> cmd: call
}
compiler: "SQL Compiler" {
  tok: Tokenizer
  parser: Parser
  codegen: "Code\nGenerator"
  tok -> parser: tokens
  parser -> codegen: AST
}
backend: "Storage Backend" {
  btree: "B-Tree"
  pager: "Pager" [shape: cache]
  vfs: "OS VFS" [shape: database]
  btree -> pager: pages
  pager -> vfs: "I/O"
}

core.cmd -> compiler.tok: "SQL text"
compiler.codegen -> core.vm: "bytecode"
core.vm -> backend.btree: "cursors"
