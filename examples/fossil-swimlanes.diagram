# Distributed peer check-in swimlanes (after Fossil's branching & syncing paper).
alan: "Alan (origin)" {
  a1: "check-in 1"
  a3: "fork 3"
  a2: "check-in 2"
  a1 -> a3: fork
  a1 -> a2: trunk
}
betty: "Betty (peer)" {
  b3: "pull 3"
  b4: "check-in 4"
  b3 -> b4: branch
}
charlie: "Charlie (offline)" {
  c2: "clone 2"
  c5: "offline 5"
  c2 -> c5
}
darlene: "Darlene (merge)" {
  d4: "pull 3,4"
  d5: "pull 5"
  d6: "merge 6"
  d4 -> d6
  d5 -> d6: merge
}

alan.a3 -> betty.b3: sync
alan.a2 -> charlie.c2: clone
betty.b4 -> darlene.d4: push
charlie.c5 -> darlene.d5: push

flow converge "Distributed convergence" {
  alan.a1 -> alan.a2 -> charlie.c2 -> charlie.c5 -> darlene.d5 -> darlene.d6
}
